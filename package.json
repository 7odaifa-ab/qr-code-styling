{
  "name": "@zakhm_sa/qr-code-styling",
  "version": "2.0.0",
  "description": "Add a style and an image to your QR code",
  "main": "lib/qr-code-styling.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/qr-code-styling.mjs",
      "require": "./lib/qr-code-styling.common.js",
      "default": "./lib/qr-code-styling.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/eslint__js": "^9.14.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^28.0.3",
    "ajv": "^8.20.0",
    "canvas": "^3.2.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-webpack-plugin": "^6.0.0",
    "filemanager-webpack-plugin": "^10.0.1",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fixed-jsdom": "^0.0.11",
    "jsdom": "^19.0.0",
    "prettier": "^3.9.6",
    "swc-loader": "^0.2.7",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "build": "webpack --mode=production --config webpack.config.build.js",
    "build:dev": "webpack --mode=development --config webpack.config.build.js",
    "test": "jest",
    "start": "webpack serve --open --config webpack.config.dev-server.js",
    "lint-fix": "eslint --cache --fix \"src/**/*.{ts,tsx}\"",
    "ci:versionup:patch": "npm version patch --no-git-tag-version --yes && npm run commit-version",
    "ci:versionup:minor": "npm version minor --no-git-tag-version --yes && npm run commit-version",
    "ci:versionup:major": "npm version major --no-git-tag-version --yes && npm run commit-version",
    "commit-version": "git add . && git commit -m \"chore(release): v`node -p 'require(\"./package.json\").version'`\"",
    "ci:release": "npm publish --yes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7odaifa-ab/qr-code-styling.git"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "js",
    "qrjs",
    "qrstyling",
    "styling",
    "qrbranding",
    "branding",
    "qrimage",
    "image",
    "qrlogo",
    "logo",
    "design"
  ],
  "author": "7odaifa-ab <hudaifa@zakhm.sa>",
  "contributors": [
    "Denys Kozak (original author)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/7odaifa-ab/qr-code-styling/issues"
  },
  "homepage": "https://github.com/7odaifa-ab/qr-code-styling#readme",
  "allowScripts": {
    "canvas": "true",
    "@swc/core": "true",
    "unrs-resolver": "true"
  }
}
